# Copy to .env and fill in. Never commit .env.

# Chat model: any OpenAI-compatible endpoint.
# Gemini (free tier from https://aistudio.google.com):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Thinking effort for reasoning models (none, low, medium, high). Empty uses the provider default.
LLM_REASONING_EFFORT=low
# Tried in order if the primary model is overloaded (comma separated, empty for none)
LLM_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# OpenAI instead: leave LLM_BASE_URL empty and set LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60

# Embeddings: "local" (fastembed on CPU, free) or "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Used for the cost estimate printed before ingestion (USD per 1M tokens). 0 for local.
EMBEDDING_COST_PER_MILLION_TOKENS=0
# Only needed when EMBEDDING_PROVIDER=openai (EMBEDDING_MODEL=text-embedding-3-small, cost 0.02)
OPENAI_API_KEY=

# Retrieval
RETRIEVAL_TOP_K=6
# Dense search returns this many candidates; a local cross-encoder reranks them and keeps the
# best RETRIEVAL_TOP_K. Set to 0 for plain dense top-k.
RERANK_CANDIDATES=20
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Also include up to NEIGHBOR_WINDOW sections on each side of the top NEIGHBOR_EXPAND_TOP chunks,
# from the same document (0 disables)
NEIGHBOR_WINDOW=2
NEIGHBOR_EXPAND_TOP=1
MAX_REGENERATIONS=1
DEFAULT_DATASET=halden

# Storage (docker compose overrides these for the api container)
QDRANT_URL=http://localhost:6333
DATABASE_URL=postgresql://support:support@localhost:5432/support
POSTGRES_PASSWORD=support

# Public demo protection
RATE_LIMIT_PER_HOUR=20
# Keep this below your model provider's daily quota (Gemini free tier quotas are per model).
DAILY_REQUEST_CAP=150
MAX_QUESTION_CHARS=500
# Any long random string. Used to hash client IPs before storing them.
IP_HASH_SALT=change-me
# Set to true only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Data retention in days (0 keeps data forever). Cleanup runs at API startup and daily.
# If you change these, set VITE_LOG_RETENTION_DAYS / VITE_REQUEST_LOG_RETENTION_DAYS so the privacy page matches.
LOG_RETENTION_DAYS=30
REQUEST_LOG_RETENTION_DAYS=2

# CORS: the web app origin (comma separated for more than one)
WEB_ORIGIN=http://localhost:5173

# Admin token. Required in the X-Admin-Token header by POST /ingest, and lets the eval runner
# skip the public rate limit. Empty disables both. Use a long random string.
ADMIN_TOKEN=

# Web app (build time)
VITE_API_URL=http://localhost:8000
VITE_GITHUB_URL=

# Evaluation
EVAL_API_URL=http://localhost:8000
# The grader uses a different model than the agent so they draw on separate free-tier quotas.
EVAL_JUDGE_MODEL=gemini-3.1-flash-lite
EVAL_JUDGE_FALLBACK_MODELS=gemini-flash-lite-latest
EVAL_FAITHFULNESS_THRESHOLD=0.8
# Seconds to wait between questions, to stay under free-tier per-minute limits
EVAL_REQUEST_DELAY_SECONDS=12
